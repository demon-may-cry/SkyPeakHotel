# =====================================================
# SkyPeak Hotel - Environment Variables
# =====================================================

# Database Configuration
POSTGRES_DB=your_db
POSTGRES_USER=your_name
POSTGRES_PASSWORD=your_password

# Application Database Connection
DB_URL=jdbc:postgresql://localhost:5432/your_db
DB_USERNAME=your_name
DB_PASSWORD=your_password

# Administrator Account
ADMIN_EMAIL=your_email@example.com
ADMIN_PASSWORD=your_password

# JWT Configuration
JWT_TOKEN=your-super-secret-jwt-key-change-this-in-production-minimum-256-bits

# =====================================================
# Security Notes:
# - Change all default passwords before deploying to production
# - Use strong, randomly generated JWT secret key
# - Consider using Docker secrets or external secret management
# =====================================================